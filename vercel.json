{
  "version": 2,
  "name": "sales-os",
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/webhooks/(.*)", "destination": "/api/index.js" },
    { "source": "/campaign/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/unsubscribe(.*)", "destination": "/api/index.js" },
    { "source": "/sales-os", "destination": "/sales-os/index.html" },
    { "source": "/", "destination": "/sales-os/index.html" }
  ]
}
